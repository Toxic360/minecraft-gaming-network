# Gaming Netzwerk — Umgebung
# setup.sh fuellt leere Geheimnisse automatisch mit sicheren Zufallswerten.

# Oeffentliche Domain (spaeter fuer Website, Geyser advertise-addresses, SRV-Record)
DOMAIN=play.example.de

# Velocity modern forwarding (Proxy <-> Paper-Backends)
FORWARDING_SECRET=

# RCON der Backend-Server (nur intern erreichbar)
RCON_PASSWORD=

# MariaDB-Passwort fuer LuckPerms
LP_DB_PASSWORD=
